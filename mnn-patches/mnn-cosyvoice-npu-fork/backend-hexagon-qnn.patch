   const int h_kv = head_id / state->gqa_factor;
+  if (state->page_count > 0 && state->gqa_factor > 4 && state->head_dim % 64 == 0) {
+    sync_attention_process_large_gqa_reference(state, head_id, worker_index);
+    return;
+  }
   if (sync_attention_try_page_causal_len2(state, head_id, worker_index)) {
     return;
   }

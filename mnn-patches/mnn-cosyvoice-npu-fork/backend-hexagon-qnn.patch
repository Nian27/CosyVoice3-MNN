+static inline float sync_attention_load_page_k(const SyncAttentionTaskState* state, int token, int h_kv, int dim) {
+  const int page = token / state->page_size;
+  const int page_token = token - page * state->page_size;
+  const int seq_tile = page_token / 32;
+  const int seq_inner = page_token % 32;
+  const int dim_tile = dim / 32;
+  const int dim_inner = dim & 31;
+  const __fp16* k_page = (const __fp16*)state->pastKPages[page];
+  const __fp16* k_tile =
+      k_page + attn_hmx_k_tile_index(seq_tile, h_kv, dim_tile, state->n_kv_heads, state->k_icP) * 1024;
+  return (float)k_tile[seq_inner * 2 + (dim_inner / 2) * 64 + (dim_inner & 1)];
+}
+
+// The HMX grouped/page kernels are optimized for small GQA groups.  For larger
+// groups use a simple per-head implementation on DSP as the correctness path.
+// This also gives us a deterministic reference for optimizing those kernels.
+static void sync_attention_process_large_gqa_reference(const SyncAttentionTaskState* state, int head_id,
+                                                       int worker_index) {
+  const int h_kv = head_id / state->gqa_factor;
+  uint8_t* worker_workspace = sync_attention_worker_workspace(state, worker_index);
+  float* scores = NULL;
+  __fp16* weights = NULL;
+  __fp16* temp_O = NULL;
+  sync_attention_workspace_offsets(state, worker_workspace, state->qo_len, &scores, &weights, &temp_O);
+  (void)temp_O;
+
+  __fp16* head_O =
+      state->O + (size_t)head_id * (state->head_dim / 64) * state->qo_total_len * 64;
+  const int mask_start = sync_attention_mask_start_pos(state);
+  for (int q = 0; q < state->qo_len; ++q) {
+    const __fp16* q_ptr = state->Q + (size_t)q * state->qo_stride + head_id * state->head_dim;
+    int valid_n = state->N;
+    if (state->mask_stride < 0) {
+      valid_n = sync_attention_causal_valid_end(state, q + 1);
+    }
+    float* row_scores = scores + (size_t)q * state->N_padded;
+    __fp16* row_weights = weights + (size_t)q * state->N_padded;
+    for (int token = 0; token < valid_n; ++token) {
+      float dot = 0.0f;
+      for (int dim = 0; dim < state->head_dim; ++dim) {
+        dot += (float)q_ptr[dim] * sync_attention_load_page_k(state, token, h_kv, dim);
+      }
+      float score = dot * state->scale;
+      if (state->mask != NULL && state->mask_stride > 0 && token >= mask_start) {
+        score += state->mask[(size_t)q * state->mask_stride + token - mask_start];
+      }
+      row_scores[token] = score;
+    }
+    sync_attention_softmax_row(row_weights, row_scores, valid_n);
+
+    for (int dim = 0; dim < state->head_dim; ++dim) {
+      float value = 0.0f;
+      for (int token = 0; token < valid_n; ++token) {
+        value += (float)row_weights[token] * sync_attention_load_page_v(state, token, h_kv, dim);
+      }
+      const int pack = dim / 64;
+      const int inner = dim & 63;
+      head_O[(size_t)pack * state->qo_total_len * 64 + (state->q_offset + q) * 64 + inner] = (__fp16)value;
+    }
+  }
+}
+

+void Sampler::stepCosyVoiceRange(SamplerState& state) {
+    const int begin = std::max(0, mConfig.cosyVoiceSpeechOffset);
+    const int end = std::min(state.vocab_size, begin + mConfig.cosyVoiceSpeechTokenCount);
+    std::vector<int> indices;
+    std::vector<float> logits;
+    indices.reserve(std::max(0, end - begin) + 1);
+    logits.reserve(std::max(0, end - begin) + 1);
+    for (int token = begin; token < end; ++token) {
+        indices.push_back(token);
+        logits.push_back(state.logits[token]);
+    }
+    if ((int)mContext->output_tokens.size() >= mConfig.cosyVoiceMinTokens &&
+        mConfig.cosyVoiceEosTokenId >= 0 &&
+        mConfig.cosyVoiceEosTokenId < state.vocab_size &&
+        (mConfig.cosyVoiceEosTokenId < begin || mConfig.cosyVoiceEosTokenId >= end)) {
+        indices.push_back(mConfig.cosyVoiceEosTokenId);
+        logits.push_back(state.logits[mConfig.cosyVoiceEosTokenId]);
+    }
+    state.indices = std::move(indices);
+    state.logits = std::move(logits);
+    state.is_subset = true;
+    state.invalidateProbs();
+}
